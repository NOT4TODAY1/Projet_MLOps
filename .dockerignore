# .dockerignore - Fichiers à exclure lors de la construction de l'image Docker

# Environnements virtuels Python
venv/
venv_wsl/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Fichiers de cache Python
*.egg-info/
dist/
build/
*.egg

# Fichiers de développement
.vscode/
.idea/
*.swp
*.swo
*~

# Fichiers de versioning (optionnel - peut être inclus si nécessaire)
.git/
.gitignore
.gitattributes

# Documentation et fichiers de configuration locaux
*.md
!README.md
Makefile

# Frontend (non nécessaire pour l'API backend)
frontend/
node_modules/

# Fichiers de données volumineux (optionnel - peut être inclus si nécessaire)
# alzheimers_disease_data.csv  # Décommenter si le fichier est trop volumineux

# Fichiers de résultats (optionnel - peut être inclus si nécessaire)
results/
*.png
*.jpg
*.jpeg

# Fichiers temporaires
*.log
*.tmp
.DS_Store
Thumbs.db

# Fichiers de test
test_*.py
*_test.py
tests/

# Notebooks Jupyter
*.ipynb
.ipynb_checkpoints/

# Fichiers de configuration locaux
.env
.env.local

